.DS_Store
.Rhistory
.RData
.Rapp.history
.Rproj.user/

# R session
*~

# Local path overrides. Every machine-specific path lives here, never in
# tracked code; config.local.example.R shows what goes in it.
config.local.R

# Generated outputs — track the deliverables (ecospace_ascii/, plots/)
# but not the heavy intermediates (sdm/, clipped/, combined/, run logs).
out/**
!out/*/
!out/*/ecospace_ascii/
!out/*/ecospace_ascii/**
!out/*/plots/
!out/*/plots/**

# FWC API cache — pulled on demand by fn.get_fwc_data
cell_counts/

# Optional MODIS FLH raw stacks (rebuilt with fn.pull_MODIS_flh_erddap;
# the FLH polys Rdata IS tracked).
MODIS/flh_*.gri
MODIS/flh_*.grd
MODIS/erddap_modis_datasets_*.csv

# Derived VIIRS stack (rebuilt from the tracked .tif files by
# fn.viirs_tifs2stack on every run).
VIIRS/VIIRS_*.grd
VIIRS/VIIRS_*.gri

# Local Claude state
.claude/

# Logs
*.log
