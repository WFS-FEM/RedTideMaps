morts = read.csv(paste0(dirname(getwd()),"/EwE/NWACS-MICE v3.3-Mortalities.csv"))
morts = morts[!is.na(morts$X),]
morts$M = morts$Prod.biom.or.Z-morts$X..Fishing.mort..rate
